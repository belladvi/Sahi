// Prisma schema for Sahi. Ticket 02: connectivity + a trivial model.
// The real domain model (build-spec §4) lands in later tickets.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Trivial record used to prove the DB round-trip end to end.
model Note {
  id        String   @id @default(cuid())
  text      String
  createdAt DateTime @default(now())
}
