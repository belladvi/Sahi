// Prisma schema for Sahi.
// Ticket 02: connectivity (Note). Ticket 03: Better Auth tables (User/Session/Account/Verification).
// The rest of the domain model (build-spec §4) lands in later tickets.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Trivial record used to prove the DB round-trip end to end (ticket 02).
model Note {
  id        String   @id @default(cuid())
  text      String
  createdAt DateTime @default(now())
}

// --- Application draft (M1: free front door) ---

model Application {
  id             String   @id @default(cuid())
  draftToken     String   @unique
  bakerId        String? // linked after account creation (M2)
  status         String   @default("draft") // draft|paid|preparing|filed|gov_query|approved

  // eligibility (screen 2)
  products     String[] @default([])
  premises     String? // own|rent
  turnoverBand String? // basic|above

  // describe (screen 3)
  businessName String?
  description  String?

  // category-translation engine output (hidden from the baker)
  kindOfBusiness String?
  category       String?
  subCategory    String?

  formA     Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments Payment[]
}

// --- Payment (M2 ticket 12: ₹599 checkout) ---

model Payment {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  orderId       String      @unique // gateway order id (Razorpay order_…)
  paymentId     String? // gateway payment id (set on capture)
  amount        Int // in paise (₹599 = 59900)
  currency      String      @default("INR")
  status        String      @default("created") // created|paid|failed
  eventId       String?     @unique // gateway webhook event id (idempotency guard)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

// --- Object storage (M3 ticket 13: stub backend for signed-URL uploads) ---
// In prod-with-keys this table is unused (files live in S3/R2); the stub stores
// bytes here so signed upload/download works end-to-end without a cloud bucket.
model StoredObject {
  key         String   @id // e.g. applications/<appId>/aadhaar/<uuid>
  contentType String
  data        Bytes
  size        Int
  createdAt   DateTime @default(now())
}

// --- Better Auth (ticket 03) ---

model User {
  id                  String    @id @default(cuid())
  name                String?
  email               String?   @unique
  emailVerified       Boolean   @default(false)
  image               String?
  phoneNumber         String?   @unique
  phoneNumberVerified Boolean   @default(false)
  role                String    @default("baker")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  sessions            Session[]
  accounts            Account[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}
