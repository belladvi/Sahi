# Sahi — environment template. Copy to .env (local) and .env.prod (Railway).
# Never commit .env or .env.prod (both are gitignored via the .env* pattern).

# --- Runtime ---
NODE_ENV=development
PORT=3001

# --- URLs ---
# local:   CORS_ORIGIN=http://localhost:5173
# prod:    CORS_ORIGIN=https://your-app.up.railway.app
CORS_ORIGIN=http://localhost:5173

# local:   VITE_API_BASE_URL=http://localhost:3001
# prod:    (leave empty — API and SPA are served from the same origin)
VITE_API_BASE_URL=http://localhost:3001

# local:   APP_BASE_URL=http://localhost:5173
# prod:    APP_BASE_URL=https://your-app.up.railway.app
APP_BASE_URL=http://localhost:5173

# --- Database (Neon Postgres) ---
# Pooled connection for runtime (note ?pgbouncer=true), direct for migrations.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require&channel_binding=require&pgbouncer=true
DIRECT_URL=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require&channel_binding=require

# --- Added in later tickets (kept here so both env files stay in sync) ---
# BETTER_AUTH_SECRET=
# BETTER_AUTH_URL=http://localhost:3001
